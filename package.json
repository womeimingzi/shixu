{
  "name": "shixu",
  "productName": "拾序",
  "version": "0.2.0",
  "description": "陪你把科研、课程和生活一件件安排好的桌面日程",
  "author": "womeimingzi",
  "license": "MIT",
  "homepage": "https://github.com/womeimingzi/shixu#readme",
  "repository": { "type": "git", "url": "git+https://github.com/womeimingzi/shixu.git" },
  "bugs": { "url": "https://github.com/womeimingzi/shixu/issues" },
  "keywords": ["windows", "electron", "planner", "reminders", "local-first", "productivity"],
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "preview": "node tools/preview.mjs",
    "setup:runtime": "node node_modules/electron/install.js",
    "dist": "electron-builder --win --x64 --dir",
    "package:zip": "powershell -NoProfile -File tools/package-zip.ps1",
    "icon": "powershell -NoProfile -File tools/make-icon.ps1"
  },
  "build": {
    "appId": "com.shixu.desktop",
    "productName": "拾序",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "src/**",
      "handdrawn-preview.html",
      "assets/mascots/handdrawn-cat-v1.png",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "extraFiles": [
      { "from": "LICENSE", "to": "LICENSE.shixu.txt" },
      { "from": "使用说明.txt", "to": "使用说明.txt" },
      { "from": "docs/USER_GUIDE.en.txt", "to": "README.en.txt" }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "executableName": "拾序"
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
